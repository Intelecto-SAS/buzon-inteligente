# Supabase — proyecto propio. Nunca commitear valores reales.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado de tokens OAuth (32 bytes en base64). Generar: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Permite que el primer usuario autenticado cree la organización si no existe ninguna.
BOOTSTRAP_ENABLED=false

# URL pública de esta aplicación (callbacks OAuth y webhooks).
APP_URL=http://localhost:3000

# Microsoft Entra ID / Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Secreto para validar clientState de suscripciones Graph (cadena aleatoria larga).
MICROSOFT_WEBHOOK_SECRET=

# Google Cloud / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
# Audiencia esperada del JWT de Pub/Sub (URL del webhook).
GOOGLE_PUBSUB_AUDIENCE=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# IA opcional. Compatible con API de chat completions. Vacío = el motor de reglas opera solo.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Correo transaccional para alertas internas (SMTP). Vacío = solo notificaciones in-app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
